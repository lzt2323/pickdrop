{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "拾传 Preview",
  "version": "0.6.0-alpha.4",
  "identifier": "app.pickdrop.tauri.preview",
  "build": {
    "beforeDevCommand": "node src-tauri/prepare-android.mjs && pnpm dev",
    "beforeBuildCommand": "pnpm build && node src-tauri/prepare-android.mjs",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "拾传 Preview",
        "width": 320,
        "height": 420,
        "minWidth": 300,
        "minHeight": 360,
        "maxWidth": 380,
        "maxHeight": 520,
        "maximizable": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "infoPlist": "Info.plist"
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 6003
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
