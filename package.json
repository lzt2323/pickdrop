{
  "name": "pickdrop",
  "version": "0.6.0-alpha.10",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "type": "module",
  "description": "拾传：聊天式局域网文件收件箱",
  "scripts": {
    "start": "pnpm --dir apps/tauri tauri dev",
    "desktop:package": "pnpm --dir apps/tauri tauri build",
    "desktop:package:windows": "pnpm --dir apps/tauri tauri build --bundles nsis",
    "mobile:start": "pnpm --dir apps/tauri tauri android dev",
    "mobile:web": "pnpm --dir apps/tauri dev",
    "mobile:smoke": "pnpm --dir apps/tauri test:browser",
    "tauri:dev": "pnpm --dir apps/tauri tauri dev",
    "tauri:build": "pnpm --dir apps/tauri tauri build",
    "tauri:android:init": "pnpm --dir apps/tauri tauri android init",
    "tauri:android:build": "pnpm --dir apps/tauri tauri android build --target aarch64 --apk",
    "tauri:ios:init": "pnpm --dir apps/tauri tauri ios init",
    "tauri:ios:build": "pnpm --dir apps/tauri tauri ios build",
    "tauri:check": "cargo test -p pickdrop-core && cargo check -p pickdrop-tauri && pnpm --dir apps/tauri build",
    "version:check": "node scripts/verify-versions.js",
    "tauri:test:runtime": "cargo build -p pickdrop-core --example ui_bridge --locked && node tests/tauri-runtime-smoke.mjs",
    "test:node": "node --test --test-concurrency=1 tests/*.test.js",
    "test:frontend": "pnpm --dir apps/tauri test",
    "structure:check": "node scripts/check-structure.js",
    "check:frontend": "node scripts/check-syntax.js frontend",
    "test": "pnpm test:node && pnpm test:frontend",
    "check": "pnpm structure:check && pnpm check:frontend"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
