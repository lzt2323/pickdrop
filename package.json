{
  "name": "pickdrop",
  "version": "0.6.0-alpha.1",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "type": "module",
  "description": "拾传：聊天式局域网文件收件箱",
  "main": "apps/desktop/main.cjs",
  "scripts": {
    "start": "pnpm --dir apps/tauri tauri dev",
    "server": "node server/cli.js",
    "test": "pnpm test:node",
    "check": "pnpm structure:check && pnpm check:frontend && pnpm check:legacy",
    "desktop:smoke": "pnpm legacy:desktop:smoke",
    "desktop:package": "pnpm --dir apps/tauri tauri build",
    "desktop:package:windows": "pnpm --dir apps/tauri tauri build --bundles nsis",
    "mobile:start": "pnpm --dir apps/tauri tauri android dev",
    "mobile:web": "pnpm --dir apps/tauri dev",
    "mobile:smoke": "pnpm --dir apps/tauri test:browser",
    "mobile:check": "pnpm legacy:mobile:check",
    "mobile:export": "pnpm legacy:mobile:export",
    "desktop:prepare": "pnpm legacy:desktop:prepare",
    "desktop:motion": "pnpm legacy:desktop:motion",
    "desktop:visual": "pnpm legacy:desktop:visual",
    "tui": "node apps/tui/cli.js",
    "linux:package": "node scripts/package-linux.js",
    "desktop:requests": "pnpm legacy:desktop:requests",
    "tui:visual": "node scripts/tui-visual-smoke.js",
    "desktop:quit": "pnpm legacy:desktop:quit",
    "desktop:peer": "pnpm legacy:desktop:peer",
    "desktop:lifecycle": "pnpm legacy:desktop:lifecycle",
    "start:legacy": "pnpm legacy:start",
    "tauri:dev": "pnpm --dir apps/tauri tauri dev",
    "tauri:build": "pnpm --dir apps/tauri tauri build",
    "tauri:android:init": "pnpm --dir apps/tauri tauri android init",
    "tauri:android:build": "pnpm --dir apps/tauri tauri android build --target aarch64 --apk",
    "tauri:ios:init": "pnpm --dir apps/tauri tauri ios init",
    "tauri:ios:build": "pnpm --dir apps/tauri tauri ios build",
    "tauri:check": "cargo test -p pickdrop-core && cargo check -p pickdrop-tauri && pnpm --dir apps/tauri build",
    "mobile:start:legacy": "pnpm legacy:mobile:start",
    "mobile:web:legacy": "pnpm legacy:mobile:web",
    "mobile:smoke:legacy": "pnpm legacy:mobile:smoke",
    "desktop:package:legacy": "pnpm legacy:desktop:package",
    "desktop:package:windows:legacy": "pnpm legacy:desktop:package:windows",
    "version:check": "node scripts/verify-versions.js",
    "tauri:test:runtime": "cargo build -p pickdrop-core --example ui_bridge --locked && node tests/tauri-runtime-smoke.mjs",
    "test:node": "node --test --test-concurrency=1 tests/*.test.js",
    "test:frontend": "pnpm --dir apps/tauri test",
    "structure:check": "node scripts/check-structure.js",
    "check:frontend": "node scripts/check-syntax.js frontend",
    "check:legacy": "node scripts/check-syntax.js legacy",
    "legacy:desktop:smoke": "node scripts/desktop-groups-smoke.js",
    "legacy:mobile:check": "pnpm --dir apps/mobile check",
    "legacy:mobile:export": "pnpm --dir apps/mobile export:check",
    "legacy:desktop:prepare": "node scripts/prepare-desktop.js",
    "legacy:desktop:motion": "node scripts/desktop-motion-smoke.js",
    "legacy:desktop:visual": "node scripts/desktop-visual-smoke.js",
    "legacy:desktop:requests": "node scripts/desktop-requests-smoke.js",
    "legacy:desktop:quit": "node scripts/desktop-quit-smoke.js",
    "legacy:desktop:peer": "node scripts/desktop-peer-smoke.js",
    "legacy:desktop:lifecycle": "node scripts/desktop-lifecycle-smoke.js",
    "legacy:start": "electron .",
    "legacy:mobile:start": "pnpm --dir apps/mobile start",
    "legacy:mobile:web": "pnpm --dir apps/mobile web",
    "legacy:mobile:smoke": "node scripts/mobile-ui-smoke.js",
    "legacy:desktop:package": "pnpm legacy:desktop:prepare && electron-builder --config electron-builder.cjs --mac dir --arm64 && node scripts/archive-mac.js",
    "legacy:desktop:package:windows": "pnpm legacy:desktop:prepare && electron-builder --config electron-builder.cjs --win portable --x64"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "bonjour-service": "1.4.4",
    "qrcode": "1.5.4",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright": "1.62.1"
  }
}
